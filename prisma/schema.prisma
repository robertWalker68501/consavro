// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  businessMemberships BusinessMember[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  authoredActivityEvents BusinessActivityEvent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// A business is a separate data-ownership boundary.
model Business {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  defaultCommissionRate Decimal @default(30.00) @db.Decimal(5, 2)
  members   BusinessMember[]
  clients   Client[]
  inventoryItems InventoryItem[]
  sales Sale[]
  payouts Payout[]
  notifications Notification[]
  activityEvents BusinessActivityEvent[]
  sellerPickups SellerPickup[]
  pickupItems SellerPickupItem[]

  @@map("business")
}

enum BusinessRole {
  OWNER
  MANAGER
  STAFF
}

model BusinessMember {
  id         String       @id @default(cuid())
  businessId String
  userId     String
  role       BusinessRole
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_member")
}

// Client records are scoped to one business and retained when archived.
model Client {
  id         String    @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  addressLine1 String?
  addressLine2 String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  notes      String?  @db.Text
  commissionRateOverride Decimal? @db.Decimal(5, 2)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  inventoryItems InventoryItem[]
  payouts Payout[]
  sellerPickups SellerPickup[]

  @@index([businessId, archivedAt])
  @@map("client")
}

// Inventory is business-owned; consignor assignment and product specifics follow in Layer 2.
model InventoryItem {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  sku         String?
  quantity    Int       @default(1)
  status      InventoryStatus @default(IN_STOCK)
  description String?   @db.Text
  setNumber String?
  theme String?
  condition LegoCondition?
  completeness LegoCompleteness?
  askingPrice Decimal? @db.Decimal(12, 2)
  estimatedValue Decimal? @db.Decimal(12, 2)
  legoSetId String?
  legoSet LegoSet? @relation(fields: [legoSetId], references: [id], onDelete: SetNull)
  clientId String?
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales Sale[]
  sourcePickupItem SellerPickupItem? @relation("PickupInventory")

  @@index([businessId, archivedAt])
  @@index([businessId, status])
  @@index([businessId, clientId])
  @@index([legoSetId])
  @@map("inventory_item")
}

// Shared product identity. No business ownership, prices, consignors or sales here.
// Catalog writes are intentionally not exposed through business Server Actions.
model LegoSet {
  id           String @id @default(cuid())
  setNumber    String @unique @db.VarChar(40)
  name         String @db.VarChar(200)
  theme        String? @db.VarChar(120)
  releaseYear  Int?
  pieceCount   Int?
  imageUrl     String? @db.Text
  source       LegoCatalogSource @default(MANUAL)
  externalId   String? @db.VarChar(100)
  sourceUrl    String? @db.Text
  verificationStatus LegoSetVerificationStatus @default(UNVERIFIED)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  inventoryItems InventoryItem[]
  pickupItems SellerPickupItem[]

  @@index([name])
  @@index([theme, releaseYear])
  @@index([source, externalId])
  @@map("lego_set")
}

enum LegoCatalogSource {
  MANUAL
  REBRICKABLE
}

enum LegoSetVerificationStatus {
  UNVERIFIED
  VERIFIED
  NEEDS_REVIEW
}

enum LegoCondition {
  NEW_SEALED
  NEW_OPEN_BOX
  USED
}

enum LegoCompleteness {
  COMPLETE
  INCOMPLETE
  UNKNOWN
}

enum InventoryStatus {
  IN_STOCK
  RESERVED
  SOLD
}

// Layer 1: a recorded sale is an immutable historical transaction entry.
// Inventory fulfillment, commissions, and payouts are introduced in later layers.
model Sale {
  id String @id @default(cuid())
  businessId String
  inventoryItemId String
  itemName String
  salePrice Decimal @db.Decimal(12, 2)
  // Financial snapshot: changes to client/business policies never alter a past sale.
  consignorId String?
  consignorName String?
  commissionRate Decimal @default(0) @db.Decimal(5, 2)
  commissionAmount Decimal @default(0) @db.Decimal(12, 2)
  consignorProceeds Decimal @default(0) @db.Decimal(12, 2)
  soldAt DateTime
  cancelledAt DateTime?
  // Inventory values immediately before fulfillment, used to restore a cancelled sale.
  inventoryQuantityBefore Int?
  inventoryStatusBefore InventoryStatus?
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  payout Payout?

  @@index([businessId, soldAt])
  @@index([businessId, inventoryItemId])
  @@map("sale")
}

// One complete, immutable payment record per sale in the initial payout workflow.
model Payout {
  id String @id @default(cuid())
  businessId String
  saleId String @unique
  clientId String
  amount Decimal @db.Decimal(12, 2)
  paidAt DateTime
  method PayoutMethod
  reference String? @db.VarChar(200)
  notes String? @db.Text
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([businessId, paidAt])
  @@index([businessId, clientId])
  @@map("payout")
}

enum PayoutMethod {
  CASH
  CHECK
  BANK_TRANSFER
  ZELLE
  VENMO
  OTHER
}

// User-specific notifications. Business association supports tenant-scoped events.
model Notification {
  id         String   @id @default(cuid())
  userId     String
  businessId String?
  title      String
  message    String
  href       String?
  readAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([businessId])
  @@map("notification")
}

// Per-user delivery settings; missing rows retain the all-enabled default.
model NotificationPreference {
  userId    String  @id
  inventory Boolean @default(true)
  sales     Boolean @default(true)
  payouts   Boolean @default(true)
  updatedAt DateTime @updatedAt
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

// Business-wide operational history, independent of notification delivery preferences.
// Keep the actor's name even if their account is later deleted.
model BusinessActivityEvent {
  id          String   @id @default(cuid())
  businessId  String
  actorId     String?
  actorName   String
  category    String
  title       String
  message     String
  href        String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt, id])
  @@map("business_activity_event")
}

// A pickup is a business-scoped collection event, independent of later inventory.
enum SellerPickupStatus {
  SCHEDULED
  PICKED_UP
  PROCESSING
  COMPLETED
}

model SellerPickup {
  id String @id @default(cuid())
  businessId String
  clientId String
  reference String @unique @default(cuid())
  scheduledAt DateTime
  pickedUpAt DateTime?
  status SellerPickupStatus @default(SCHEDULED)
  location String? @db.VarChar(500)
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items SellerPickupItem[]

  @@index([businessId, status, scheduledAt])
  @@index([businessId, clientId])
  @@map("seller_pickup")
}

// Collected goods are not inventory until a later processing workflow.
enum SellerPickupItemKind {
  CATALOG_SET
  UNIDENTIFIED_SET
  BULK_LOT
}

enum PickupProcessingStatus {
  PENDING
  IN_PROGRESS
  READY
  ON_HOLD
}

enum PickupItemCondition {
  UNKNOWN
  NEW
  USED
}

enum PickupItemCompleteness {
  UNKNOWN
  COMPLETE
  INCOMPLETE
}

model SellerPickupItem {
  id String @id @default(cuid())
  pickupId String
  businessId String
  kind SellerPickupItemKind
  legoSetId String?
  name String @db.VarChar(200)
  setNumber String? @db.VarChar(40)
  theme String? @db.VarChar(120)
  quantity Int @default(1)
  description String? @db.Text
  condition PickupItemCondition @default(UNKNOWN)
  completeness PickupItemCompleteness @default(UNKNOWN)
  inspectionNotes String? @db.Text
  processingStatus PickupProcessingStatus @default(PENDING)
  inventoryItemId String? @unique
  inventoryItem InventoryItem? @relation("PickupInventory", fields: [inventoryItemId], references: [id], onDelete: Restrict)
  estimatedValue Decimal? @db.Decimal(12, 2)
  askingPrice Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pickup SellerPickup @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  legoSet LegoSet? @relation(fields: [legoSetId], references: [id], onDelete: SetNull)

  @@index([pickupId, createdAt])
  @@index([businessId, pickupId])
  @@index([legoSetId])
  @@map("seller_pickup_item")
}
